{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ackb:multi-backend-query:v1",
  "title": "ACKB AscendC and CCE Dialect query envelope v1",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "ackb.multi-backend.query.v1"
    },
    "backend": {
      "enum": [
        "ascendc",
        "cce-dialect"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "error"
      ]
    },
    {
      "required": [
        "backend",
        "operation",
        "version",
        "items",
        "total",
        "offset",
        "next_offset",
        "truncated",
        "provenance",
        "verification",
        "limitations"
      ]
    }
  ]
}
