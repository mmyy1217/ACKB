{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmyy1217.github.io/ACKB/schemas/llvm-ir-v1.schema.json",
  "title": "ACKB LLVM IR versioned index",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "target",
    "sources",
    "ops",
    "forms",
    "relations",
    "scans",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "ackb.llvm.index.v1"
    },
    "version": {
      "type": "string"
    },
    "target": {
      "const": "Ascend950PR_9579"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/op"
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/form"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "overload_name_candidate"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "a5_call_table": {
      "type": "object",
      "required": [
        "encoding",
        "columns",
        "callers",
        "forms",
        "sources",
        "rows"
      ],
      "properties": {
        "encoding": {
          "const": "dictionary-v1"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "path",
        "sha256",
        "package_status"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "enum": [
            "cann"
          ]
        },
        "package_status": {
          "enum": [
            "verified",
            "not_verified",
            "not_applicable"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "registry",
            "binary_string",
            "bitcode_declaration"
          ]
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "bit_offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domain",
        "identity_status",
        "target_status",
        "presence",
        "form_ids",
        "evidence",
        "verification",
        "a5_source_lead"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^llvm_ir_[0-9a-f]{20}$"
        },
        "name": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "target_intrinsic",
            "standard_intrinsic"
          ]
        },
        "identity_status": {
          "enum": [
            "candidate_only",
            "registered",
            "declaration_observed"
          ]
        },
        "target_status": {
          "enum": [
            "unknown",
            "c310_module_declaration"
          ]
        },
        "presence": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "observed",
              "scanned_absent",
              "not_scanned"
            ]
          }
        },
        "form_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "compile",
            "runtime",
            "performance"
          ],
          "additionalProperties": {
            "const": "unverified"
          }
        },
        "static_target": {
          "type": "object",
          "required": [
            "status",
            "package_evidence",
            "call_count",
            "module_cores",
            "support",
            "exclusion"
          ],
          "properties": {
            "status": {
              "enum": [
                "reference_model",
                "c310_direct_call",
                "c310_declaration",
                "a5_name_only",
                "external_only",
                "cross_arch_registry",
                "insufficient"
              ]
            },
            "support": {
              "const": "not_established"
            },
            "exclusion": {
              "const": "not_established"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_status": {
                "const": "candidate_only"
              }
            }
          },
          "then": {
            "properties": {
              "form_ids": {
                "maxItems": 0
              },
              "target_status": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "form": {
      "type": "object",
      "required": [
        "id",
        "op_id",
        "kind",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "registry_constraints",
            "observed_signature"
          ]
        },
        "status": {
          "enum": [
            "decoded_llvm15_constraints",
            "unparsed_vendor_encoding"
          ]
        },
        "signature_status": {
          "enum": [
            "parsed",
            "partial_vendor_types"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "unparsed_vendor_encoding"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "signature"
              ]
            }
          }
        }
      ]
    },
    "query_envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "backend",
        "operation",
        "total",
        "offset",
        "items",
        "next_offset",
        "truncated"
      ],
      "properties": {
        "schema_version": {
          "const": "ackb.llvm.query.v1"
        },
        "backend": {
          "const": "llvm"
        },
        "items": {
          "type": "array"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
